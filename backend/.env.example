# MongoDB Atlas connection string (no credentials hardcoded in source)
MONGO_URI=mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# JWT secret — generate a strong random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_min_32_chars

# Server port
PORT=5000

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_key_here

# Google OAuth Client ID (public by OAuth design, but kept out of source)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Allowed CORS origins (comma-separated). Set explicitly in production.
CORS_ORIGINS=https://your-frontend.netlify.app,http://localhost:5500

# Max request body size
MAX_REQUEST_BODY=100kb

# Rate limiting windows (ms) and max requests
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX_ACCOUNT=15
AUTH_BACKOFF_BASE_MS=60000
AUTH_BACKOFF_MAX_MS=3600000

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30

USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX=100

ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=30

NODE_ENV=production
